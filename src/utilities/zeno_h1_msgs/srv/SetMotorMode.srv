# 设置电机模式服务
# 请求切换电机工作模式

# 请求
string motor_id          # 电机标识符
uint8 mode               # 目标模式（电机特定，参考电机文档）
                         # 达妙电机：0=MIT, 1=位置速度, 2=速度, 3=力位混控
                         # 高擎电机：0=力矩, 1=位置, 2=速度, 3=协同

---
# 响应
bool success             # 操作是否成功
string message           # 状态消息

